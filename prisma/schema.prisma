generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id                             String    @id @default(uuid()) @db.Uuid
  name                           String
  whatsapp_number                String?   @unique
  owner_email                    String?   @unique
  password                       String?   // Hashed password for NextAuth
  meta_phone_number_id           String?
  meta_access_token              String?
  custom_greeting                String?
  store_address                  String?
  promo_banner                   String?
  is_active                      Boolean   @default(true)
  gold_rate_per_gram             Decimal?  // Today's 24K Gold Rate per gram in INR
  silver_rate_per_gram           Decimal?  // Today's Silver Rate per gram in INR
  default_making_charge_percent Decimal?  // Default Making Charge %
  created_at                     DateTime  @default(now())

  products                       Product[]
  leads                          Lead[]
  broadcasts                     BroadcastCampaign[]

  @@map("shops")
}

model Product {
  id                    String   @id @default(uuid()) @db.Uuid
  shop_id               String   @db.Uuid
  name                  String
  type                  String?
  metal                 String?
  karat                 String?  // e.g. 22K, 18K, 14K, 24K, 925 Silver
  weight_grams          Decimal? // Weight in Grams
  making_charge_percent Decimal? // Specific Making Charge %
  price                 Decimal?
  url                   String?
  image_url             String?
  created_at            DateTime @default(now())

  shop                  Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@map("products")
}

model Lead {
  id                String   @id @default(uuid()) @db.Uuid
  shop_id           String   @db.Uuid
  customer_phone    String
  customer_name     String?
  message_count     Int      @default(1)
  daily_image_count Int      @default(0)
  is_active         Boolean  @default(true)
  last_contacted_at DateTime @default(now())
  created_at        DateTime @default(now())

  shop              Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@unique([shop_id, customer_phone])
  @@map("leads")
}

model BroadcastCampaign {
  id               String   @id @default(uuid()) @db.Uuid
  shop_id          String   @db.Uuid
  message_text     String
  image_url        String?
  total_recipients Int
  success_count    Int
  fail_count       Int
  created_at       DateTime @default(now())

  shop             Shop     @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@map("broadcast_campaigns")
}
